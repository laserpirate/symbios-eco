<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>VANA · Growth Manifold Studio · SymbiOS™</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet"/>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#090e08;--sur:#0d160c;--sur2:#0f180e;--sur3:#0a1209;--bor:#1e2e1d;--bor2:#1a2a19;
  --cream:#e8e0d0;--ivory:#c8c0b0;--gold-pale:#d8d4be;--gold:#c8a96e;
  --teal:#55c4a0;--bright:#9ed855;--purple:#9a8ae8;--blue:#6ab4e8;--coral:#c45a3a;
  --amber:#c4904a;--rust:#b0894a;
  --dim:#3a5a38;--mid:#4a6a48;--body:#6a8a68;--muted:#2a4a28;--faint:#8a9a82;
  --mono:'DM Mono',monospace;--serif:'Cormorant Garamond',serif;
}
html,body{height:100%}
body{background:var(--bg);color:var(--cream);font-family:var(--mono);
  display:flex;flex-direction:column;overflow:hidden;
  background-image:radial-gradient(140% 90% at 50% -10%,#0d1a0c 0%,#090e08 55%);}
::-webkit-scrollbar{width:4px;height:4px}::-webkit-scrollbar-thumb{background:var(--muted);border-radius:2px}
::-webkit-scrollbar-track{background:transparent}
button{font-family:var(--mono);cursor:pointer;color:inherit;background:none;border:none}
.italic{font-family:var(--serif);font-style:italic}

@keyframes pulse{0%,100%{opacity:.45}50%{opacity:1}}
@keyframes nodeflash{0%{background:#13251f;border-color:var(--teal);box-shadow:0 0 0 0 rgba(85,196,160,.4)}
  100%{background:var(--sur2);border-color:var(--bor);box-shadow:0 0 0 6px rgba(85,196,160,0)}}
@keyframes breathe{0%,100%{transform:scale(1) skewX(0deg)}50%{transform:scale(1.012) skewX(.35deg)}}
@keyframes toastin{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

/* ---------- NAV ---------- */
nav{flex-shrink:0;height:46px;display:flex;align-items:center;justify-content:space-between;
  padding:0 1rem;border-bottom:1px solid var(--bor);background:rgba(9,14,8,.92);
  backdrop-filter:blur(10px);position:relative;z-index:30}
.brand{display:flex;align-items:baseline;gap:.5rem}
a.brand{text-decoration:none;cursor:pointer}
a.brand:hover .wm{text-shadow:0 0 16px rgba(85,196,160,.45)}
a.brand:hover .sub{color:var(--teal)}
.nav-home{display:inline-flex;align-items:center;gap:.3rem;border:1px solid var(--bor);border-radius:4px;
  padding:.32rem .6rem;font-size:.5rem;letter-spacing:.1em;color:var(--ivory);text-decoration:none;
  font-family:var(--mono);transition:all .15s;white-space:nowrap}
.nav-home:hover{border-color:var(--teal);color:var(--teal);background:rgba(85,196,160,.08)}
.nav-home .hg{font-size:.72rem;line-height:1}
.wm{font-family:var(--serif);font-style:italic;font-size:1.2rem;color:var(--cream);letter-spacing:.14em}
.wm b{color:var(--teal);font-weight:400}
.sub{font-size:.46rem;color:var(--muted);letter-spacing:.13em}
.nav-mid{font-family:var(--serif);font-style:italic;color:var(--faint);font-size:.92rem;letter-spacing:.02em}
.nav-r{display:flex;align-items:center;gap:.6rem;font-size:.46rem;color:var(--muted);letter-spacing:.1em}
.live{display:inline-flex;align-items:center;gap:.35rem;color:var(--teal)}
.live::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--teal);animation:pulse 2s infinite}

/* ---------- LAYOUT ---------- */
main{flex:1;display:grid;grid-template-columns:268px 1fr 320px;min-height:0}
.rail{overflow-y:auto;background:var(--sur);min-height:0}
.rail.left{border-right:1px solid var(--bor)}
.rail.right{border-left:1px solid var(--bor)}
.stage{position:relative;display:flex;flex-direction:column;min-height:0;background:
  radial-gradient(120% 80% at 50% 8%,#0c160b 0%,#090e08 60%)}

.sec{padding:.85rem .9rem;border-bottom:1px solid var(--bor2)}
.sec-h{font-size:.5rem;color:var(--dim);letter-spacing:.17em;margin-bottom:.7rem;
  display:flex;align-items:center;gap:.55rem}
.sec-h::after{content:'';flex:1;height:1px;background:var(--bor2)}
.sec-h .n{color:var(--mid)}

/* ---------- FSPM PIPELINE NODES ---------- */
.node{display:flex;align-items:center;gap:.6rem;padding:.5rem .55rem;border-radius:4px;
  border:1px solid var(--bor);background:var(--sur2);margin-bottom:.4rem;position:relative}
.node.flash{animation:nodeflash 1.1s ease forwards}
.node .idx{font-size:.52rem;color:var(--teal);width:13px;flex-shrink:0;text-align:center}
.node .body{flex:1;min-width:0}
.node .nm{font-size:.6rem;color:var(--ivory);letter-spacing:.04em}
.node .eng{font-size:.46rem;color:var(--mid);letter-spacing:.05em;margin-top:1px}
.node .eng b{color:var(--teal);font-weight:400}
.node .dot{width:5px;height:5px;border-radius:50%;background:var(--muted);flex-shrink:0}
.node.flash .dot{background:var(--teal)}
.wire{height:7px;width:1px;background:var(--bor);margin-left:13px}

/* ---------- PRESETS ---------- */
.preset{width:100%;text-align:left;padding:.55rem .6rem;border-radius:4px;border:1px solid var(--bor2);
  background:transparent;margin-bottom:.35rem;transition:all .14s;border-left:2px solid transparent}
.preset:hover{background:var(--sur2);border-color:var(--bor)}
.preset.on{background:#101c0f;border-left-color:var(--teal);border-color:var(--bor)}
.preset .pn{font-family:var(--serif);font-style:italic;font-size:.92rem;color:var(--cream);line-height:1.1}
.preset .pl{font-size:.5rem;color:var(--body);margin-top:2px}
.preset .pb{display:inline-block;font-size:.44rem;color:var(--mid);letter-spacing:.1em;margin-top:.35rem;
  padding:1px 5px;border:1px solid var(--bor2);border-radius:2px}

/* ---------- L-SYSTEM RULE CARD ---------- */
.rule{background:var(--sur3);border:1px solid var(--bor2);border-radius:4px;padding:.6rem .65rem;font-size:.56rem}
.rule .ax{color:var(--mid);letter-spacing:.04em;margin-bottom:.35rem}
.rule .ax b{color:var(--teal);font-weight:500}
.rule .pr{color:var(--ivory);font-size:.66rem;letter-spacing:.02em;line-height:1.5;word-break:break-word}
.rule .pr em{color:var(--bright);font-style:normal}
.rule .meta{color:var(--mid);font-size:.48rem;margin-top:.45rem;letter-spacing:.04em}

/* ---------- MTG MINI GRAPH ---------- */
.mtg-wrap{background:var(--sur3);border:1px solid var(--bor2);border-radius:4px;padding:.4rem}
.mtg-legend{display:flex;gap:.7rem;flex-wrap:wrap;margin-top:.45rem;font-size:.44rem;color:var(--mid)}
.mtg-legend span{display:inline-flex;align-items:center;gap:.3rem}
.mtg-legend i{width:6px;height:6px;border-radius:50%;display:inline-block}

/* ---------- STAGE / VIEWPORT ---------- */
.stage-top{flex:1;position:relative;min-height:0;overflow:hidden}
#viewport{position:absolute;inset:0;width:100%;height:100%}
.vp-badge{position:absolute;top:.7rem;left:.8rem;z-index:5;display:flex;flex-direction:column;gap:.3rem}
.spec-name{font-family:var(--serif);font-style:italic;font-size:1.5rem;color:var(--cream);line-height:1}
.spec-latin{font-size:.55rem;color:var(--body);letter-spacing:.04em}
.spec-site{font-size:.5rem;color:var(--mid);letter-spacing:.05em;margin-top:.15rem}
.vp-readout{position:absolute;top:.7rem;right:.8rem;z-index:5;text-align:right;font-size:.5rem;color:var(--mid);letter-spacing:.05em;line-height:1.7}
.vp-readout b{color:var(--teal);font-weight:400}
.adapt{position:absolute;left:.8rem;bottom:.7rem;z-index:5;font-size:.52rem;letter-spacing:.04em;
  display:inline-flex;align-items:center;gap:.4rem;padding:.3rem .55rem;border-radius:3px;
  border:1px solid var(--bor);background:rgba(9,14,8,.7)}
.adapt .ad-dot{width:6px;height:6px;border-radius:50%}

/* live production-rule readout — the procedural proof, draggable, under the plant */
.vp-rule{position:absolute;left:50%;bottom:.7rem;transform:translateX(-50%);z-index:6;
  background:rgba(7,11,7,.84);border:1px solid var(--bor);border-left:2px solid var(--teal);
  border-radius:5px;padding:.45rem 1.3rem .45rem .7rem;font-family:var(--mono);text-align:left;
  backdrop-filter:blur(3px);box-shadow:0 6px 22px rgba(0,0,0,.45);
  cursor:grab;user-select:none;-webkit-user-select:none;touch-action:none;white-space:nowrap}
.vp-rule.dragging{cursor:grabbing;border-left-color:var(--bright);box-shadow:0 10px 30px rgba(0,0,0,.6)}
.vp-rule .vr-grip{position:absolute;top:.3rem;right:.45rem;font-size:.6rem;color:var(--dim);letter-spacing:-2px;line-height:1}
.vp-rule .vr-prod{font-size:.82rem;color:var(--ivory);letter-spacing:.02em;line-height:1.3;margin-bottom:.15rem}
.vp-rule .vr-prod em{color:var(--bright);font-style:normal}
.vp-rule .vr-meta{font-size:.5rem;color:var(--mid);letter-spacing:.03em;line-height:1.3;display:flex;align-items:center;gap:.3rem}
.vp-rule .vr-meta .vr-k{color:var(--dim)}
.vp-rule .vr-meta b{color:var(--teal);font-weight:500}
.vp-rule .vr-dot{width:5px;height:5px;border-radius:50%;background:var(--teal);flex-shrink:0;animation:pulse 2s infinite}
.vp-rule .vr-cur{color:var(--teal);animation:blink 1.1s step-end infinite;margin-left:1px}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0}}

/* ---------- TRANSPORT ---------- */
.transport{flex-shrink:0;border-top:1px solid var(--bor);background:var(--sur3);padding:.55rem .8rem;
  display:flex;align-items:center;gap:.9rem;flex-wrap:wrap}
.tgrp{display:flex;align-items:center;gap:.5rem}
.tlabel{font-size:.48rem;color:var(--dim);letter-spacing:.13em}
.tbtn{display:inline-flex;align-items:center;gap:.35rem;border:1px solid var(--bor);border-radius:3px;
  padding:.32rem .6rem;font-size:.52rem;color:var(--ivory);letter-spacing:.06em;transition:all .14s;background:var(--sur2)}
.tbtn:hover{border-color:var(--mid);background:#13201240}
.tbtn.on{border-color:var(--teal);color:var(--teal);background:#0f1c1640}
.tbtn .tri{font-size:.6rem;line-height:1}
.scrub{flex:1;min-width:120px;display:flex;align-items:center;gap:.55rem}
.scrub input{flex:1}
.scrub .val{font-size:.5rem;color:var(--teal);min-width:54px;text-align:right;letter-spacing:.03em}
.season-pips{display:flex;gap:.25rem}
.pip{width:18px;height:18px;border-radius:50%;border:1px solid var(--bor);font-size:0;transition:all .14s;cursor:pointer}
.pip:hover{transform:scale(1.12)}
.pip.on{border-color:var(--cream);box-shadow:0 0 0 2px rgba(232,224,208,.12)}

/* ---------- RIGHT RAIL : MANIFOLD ---------- */
.dial{margin-bottom:.7rem}
.dial-h{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:.28rem}
.dial-h .dn{font-size:.55rem;color:var(--ivory);letter-spacing:.04em}
.dial-h .dn em{font-family:var(--serif);font-style:italic;color:var(--teal);font-size:.78rem;margin-right:.3rem}
.dial-h .dv{font-size:.5rem;color:var(--body);letter-spacing:.03em}
input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:2px;background:var(--bor);
  border-radius:2px;outline:none;cursor:pointer}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;width:13px;height:13px;
  border-radius:50%;background:var(--teal);border:2px solid var(--bg);cursor:pointer;
  box-shadow:0 0 0 1px var(--muted);transition:transform .1s}
input[type=range]::-webkit-slider-thumb:hover{transform:scale(1.2)}
input[type=range]::-moz-range-thumb{width:13px;height:13px;border-radius:50%;background:var(--teal);
  border:2px solid var(--bg);cursor:pointer}
input[type=range].env::-webkit-slider-thumb{background:var(--blue)}
input[type=range].env.hot::-webkit-slider-thumb{background:var(--coral)}

/* ---------- SERVICES (Band-3) ---------- */
.svc{margin-bottom:.55rem}
.svc-h{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:.22rem}
.svc-h .sn{font-size:.52rem;color:var(--body);letter-spacing:.03em}
.svc-h .sv{font-size:.55rem;color:var(--cream);letter-spacing:.02em}
.svc-h .sv u{color:var(--mid);text-decoration:none;font-size:.46rem;margin-left:.2rem}
.bar{height:4px;border-radius:3px;background:var(--bor2);overflow:hidden}
.bar i{display:block;height:100%;border-radius:3px;transition:width .5s cubic-bezier(.2,.7,.3,1),background .4s}
.resil{display:flex;align-items:center;justify-content:space-between;padding:.5rem .6rem;border-radius:4px;
  border:1px solid var(--bor);background:var(--sur3);margin-top:.5rem}
.resil .rl{font-size:.5rem;color:var(--dim);letter-spacing:.12em}
.resil .rv{font-family:var(--serif);font-style:italic;font-size:1.5rem}

/* ---------- EXPORT CHROME ---------- */
.exp-row{display:flex;flex-wrap:wrap;gap:.3rem}
.exp{font-size:.48rem;letter-spacing:.08em;color:var(--mid);border:1px solid var(--bor2);border-radius:2px;
  padding:.3rem .5rem;transition:all .14s}
.exp:hover{border-color:var(--mid);color:var(--ivory)}
.exp.go{color:var(--teal);border-color:var(--muted)}

/* ---------- TOAST ---------- */
#toast{position:fixed;bottom:1rem;left:50%;transform:translateX(-50%);z-index:60;
  background:var(--sur);border:1px solid var(--bor);border-radius:4px;padding:.5rem .85rem;
  font-size:.55rem;color:var(--ivory);letter-spacing:.05em;display:none;animation:toastin .25s ease}
#toast b{color:var(--teal);font-weight:400}

.hint{font-size:.46rem;color:var(--mid);letter-spacing:.05em;line-height:1.6;margin-top:.5rem}
.fn-note{margin-top:.6rem;padding:.5rem .55rem;border-radius:4px;background:var(--sur3);border:1px solid var(--bor2);border-left:2px solid var(--purple)}
.fn-note+.fn-note{border-left-color:var(--gold)}
.fn-note .fh{font-size:.46rem;letter-spacing:.1em;color:var(--mid);margin-bottom:.25rem;display:flex;align-items:center;gap:.3rem}
.fn-note .fb{font-size:.52rem;color:var(--faint);line-height:1.65;font-family:var(--serif);font-style:italic}

/* ---------- GLOSSARY TOOLTIP ---------- */
.gl{border-bottom:1px dotted var(--mid);cursor:help}
.gl:hover{border-bottom-color:var(--teal);color:var(--teal)}
#gtip{position:fixed;z-index:200;max-width:230px;background:var(--sur);border:1px solid var(--bor);
  border-left:2px solid var(--teal);border-radius:4px;padding:.5rem .6rem;font-size:.52rem;line-height:1.6;
  color:var(--ivory);letter-spacing:.02em;pointer-events:none;opacity:0;transform:translateY(4px);
  transition:opacity .12s,transform .12s;box-shadow:0 8px 24px rgba(0,0,0,.5)}
#gtip.on{opacity:1;transform:translateY(0)}
#gtip b{color:var(--teal);font-weight:500;display:block;margin-bottom:.2rem;font-size:.55rem}

/* bolded INDEX section headers */
.sec-h.idx{font-size:.64rem;color:var(--cream);font-weight:500;letter-spacing:.1em}
.sec-h.idx::after{background:var(--bor)}
.idx-sub{font-size:.48rem;color:var(--mid);letter-spacing:.05em;margin:-.45rem 0 .7rem;line-height:1.5}

/* header tour (palette) button */
.tour-hero{display:inline-flex;align-items:center;gap:.4rem;border:1px solid var(--teal);border-radius:4px;
  padding:.32rem .7rem;font-size:.54rem;letter-spacing:.07em;color:var(--teal);background:#0f1c1633;transition:all .15s}
.tour-hero:hover{background:#13251f;box-shadow:0 0 14px rgba(85,196,160,.25)}
.tour-hero.on{background:var(--teal);color:#08120c;font-weight:500}
.tour-hero .tri{font-size:.6rem}

/* signals + print transport buttons share .tbtn */

/* footer bar (version / legal / date) */
.footbar{position:fixed;left:0;right:0;bottom:0;transform:translateY(0);height:24px;display:flex;align-items:center;justify-content:space-between;
  padding:0 1rem;border-top:1px solid var(--bor);background:var(--sur3);font-size:.44rem;
  color:var(--muted);letter-spacing:.08em;z-index:1}
.footbar b{color:var(--mid);font-weight:400}
.footbar .vid{color:var(--teal);letter-spacing:.12em}

/* native/introduced/invasive preset badge already inline-coloured */

@media print{
  body{background:#fff!important}
  nav,.rail,.transport,.footbar,#gtip,#toast{display:none!important}
}
/* ---------- RESPONSIVE ---------- */
@media (max-width:1080px){
  main{grid-template-columns:1fr;grid-template-rows:auto auto auto;overflow-y:auto}
  body{overflow:auto}
  .rail{max-height:none}
  .stage{min-height:62vh}
}
@media (max-width:760px){
  /* nav: drop the tagline, let it breathe, keep brand + palette tour */
  nav{height:auto;min-height:46px;flex-wrap:wrap;gap:.35rem;padding:.42rem .7rem;position:sticky;top:0}
  .nav-mid{display:none}
  .nav-r{gap:.4rem;flex-wrap:wrap;justify-content:flex-end;font-size:.42rem}
  .tour-hero{font-size:.5rem;padding:.3rem .55rem;white-space:nowrap;line-height:1.1}
  .tour-hero .tri{font-size:.55rem}
  .wm{font-size:1.05rem}.sub{display:none}

  /* stack: plant stage first, then the two rails */
  main{display:flex;flex-direction:column}
  .stage{order:-1;min-height:66vh;border-bottom:1px solid var(--bor)}
  .stage-top{min-height:56vh}
  .rail.left,.rail.right{border:none;border-top:1px solid var(--bor)}

  /* corner readouts: smaller + chipped so they label without hiding the plant */
  .spec-name{font-size:1.15rem}
  .spec-latin{font-size:.5rem}.spec-site{font-size:.45rem}
  .vp-badge{top:.45rem;left:.5rem;gap:.12rem;max-width:62%;
    background:rgba(9,14,8,.5);padding:.2rem .4rem;border-radius:4px;backdrop-filter:blur(2px)}
  .vp-readout{top:.45rem;right:.5rem;font-size:.46rem;line-height:1.55;
    background:rgba(9,14,8,.5);padding:.2rem .4rem;border-radius:4px;backdrop-filter:blur(2px)}

  /* adaptation flag: centered at the very bottom edge — never over the plant */
  .adapt{left:50%;right:auto;transform:translateX(-50%);bottom:.45rem;font-size:.46rem;
    max-width:94%;justify-content:center;text-align:center;background:rgba(9,14,8,.86)}

  .transport{gap:.5rem;padding:.5rem .6rem}
}
@media (prefers-reduced-motion:reduce){
  *{animation-duration:.001s!important}
  #canopy-grp{animation:none!important}
}

/* ---- remediation profile (xēn · represented) ---- */
#remediation{margin-top:.3rem}
.rem-arch{display:flex;flex-wrap:wrap;align-items:baseline;gap:.4rem;margin:.15rem 0 .4rem}
.rem-arch .gl{font-family:var(--serif);font-style:italic;font-size:.98rem;color:var(--gold);cursor:help;border-bottom:1px dotted var(--gold)}
.rem-role{font-size:.5rem;color:var(--faint);letter-spacing:.04em;text-transform:uppercase}
.rem-ev{--ev:#9ed855;display:flex;align-items:center;gap:.35rem;padding:.32rem .45rem;margin:.2rem 0 .5rem;
  border:1px solid color-mix(in srgb,var(--ev) 42%,transparent);border-left:3px solid var(--ev);
  border-radius:4px;background:color-mix(in srgb,var(--ev) 9%,transparent);cursor:help}
.rem-ev-dot{width:7px;height:7px;border-radius:50%;background:var(--ev);box-shadow:0 0 6px var(--ev);flex:none}
.rem-ev-lab{font-size:.56rem;color:var(--cream);letter-spacing:.02em}
.rem-ev-tag{margin-left:auto;font-size:.44rem;color:var(--faint);text-transform:uppercase;letter-spacing:.08em}
.rem-sub{font-size:.46rem;color:var(--body);text-transform:uppercase;letter-spacing:.08em;margin:.4rem 0 .22rem}
.rem-sub .n{color:var(--faint);text-transform:none;letter-spacing:0}
.rem-chips,.rem-mechs{display:flex;flex-wrap:wrap;gap:.28rem}
.rem-chip{display:inline-flex;align-items:center;gap:.26rem;font-size:.5rem;padding:.16rem .4rem;
  border:1px solid;border-radius:10px;background:rgba(255,255,255,.02);cursor:help}
.rem-chip i{width:6px;height:6px;border-radius:50%;flex:none}
.rem-mech{font-size:.5rem;padding:.16rem .4rem;border:1px solid var(--bor);border-radius:4px;
  color:var(--teal);background:rgba(85,196,160,.06);cursor:help}
.rem-target{font-size:.54rem;line-height:1.55;color:var(--body);margin-top:.5rem;
  padding-top:.4rem;border-top:1px solid var(--bor)}
.aux-pill{display:inline-block;font-size:.42rem;letter-spacing:.06em;text-transform:uppercase;
  padding:.06rem .3rem;border:1px solid var(--purple);color:var(--purple);border-radius:8px;margin-left:.3rem}

/* ---- private-demo passphrase gate ---- */
