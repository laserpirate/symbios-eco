/* ---- print / save-PDF · printer-friendly white-background snapshot ---- */
function printSpecimen(){
  const sp=SPECIES[state.species],p=state.p;
  const clone=document.getElementById('viewport').cloneNode(true);
  clone.querySelectorAll('rect').forEach(r=>r.remove());      // strip dark bg / soil / water fills
  clone.querySelectorAll('defs').forEach(r=>r.remove());
  clone.querySelectorAll('text').forEach(t=>t.setAttribute('fill','#777'));
  clone.querySelectorAll('[style]').forEach(n=>n.style.animation='none');
  const svgStr=new XMLSerializer().serializeToString(clone);
  const rows=SVC_DEFS.map(d=>`<tr><td>${d.nm}</td><td>${document.getElementById('svcv-'+d.k).textContent}</td></tr>`).join('');
  const w=window.open('','_blank','width=900,height=1100');
  if(!w){toast('popup blocked — allow popups to print');return;}
  w.document.write(`<!doctype html><html><head><meta charset="utf-8"><title>VANA · ${sp.name}</title>
   <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;1,400&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet">
   <style>*{box-sizing:border-box}body{font-family:'DM Mono',monospace;color:#1b1b1b;margin:34px;background:#fff}
   h1{font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:400;font-size:36px;margin:0;line-height:1}
   .lat{font-style:italic;color:#666;font-family:'Cormorant Garamond',serif;font-size:17px;margin:2px 0 0}
   .meta{font-size:10px;color:#999;letter-spacing:.05em;margin-top:6px}
   .frame{border:1px solid #e2e2e2;border-radius:8px;margin:16px 0;padding:8px;display:flex;justify-content:center;background:#fff}
   .frame svg{width:540px;height:auto}
   table{border-collapse:collapse;font-size:11px;width:100%;max-width:440px}
   td{border-bottom:1px solid #eee;padding:5px 8px}td:last-child{text-align:right;color:#333}
   .note{font-size:11px;color:#555;line-height:1.6;max-width:540px;margin-top:12px}
   .foot{margin-top:26px;padding-top:10px;border-top:1px solid #eee;font-size:8.5px;color:#aaa;letter-spacing:.05em;line-height:1.6}
   </style></head><body>
   <h1>${sp.name}</h1><div class="lat">${sp.latin} · ${STATUS[sp.status].l}</div>
   <div class="meta">age ${Math.round(p.age*sp.maxAge)} yr &nbsp;·&nbsp; height ${(p.age*sp.maxH).toFixed(1)} m &nbsp;·&nbsp; ${sp.site}</div>
   <div class="frame">${svgStr}</div>
   <table>${rows}<tr><td>resilience score</td><td>${document.getElementById('resil-v').textContent} / 100</td></tr></table>
   <div class="note"><b>Phytoremediation.</b> ${sp.phytoNote}</div>
   <div class="note"><b>Remediation profile.</b> ${(ARCHETYPE[sp.archetype]||{lab:sp.archetype}).lab} · addresses ${(sp.contaminants||[]).map(x=>(CONTAM[x.c]||{lab:x.c}).lab).join(', ')} · evidence: ${(EVIDENCE[sp.evidence]||{lab:sp.evidence}).lab}.</div>
   <div class="note"><b>Root system.</b> ${ROOTTYPE[sp.rootType]||sp.rootType}. <b>L-system:</b> ${sp.rule}</div>
   <div class="foot">VANA · P1-A.02 · Growth Manifold Studio · build 2026/07/12 · phyto · v2<br>© 2026 Marko Manriquez · SymbiOS™ | Inflorescence Intelligence™ · All Rights Reserved · modeled values for demonstration</div>
   <scr`+`ipt>setTimeout(function(){window.print();},500);</scr`+`ipt></body></html>`);
  w.document.close();
  toast('print view opened · <b>save as PDF</b> from the dialog');
}
document.getElementById('btn-print').addEventListener('click',printSpecimen);

/* ---- make the production-rule panel draggable (park it anywhere over the stage) ---- */
(function(){
  const el=document.getElementById('vp-rule');if(!el)return;
  let drag=false,sx=0,sy=0,ox=0,oy=0;
  el.addEventListener('pointerdown',e=>{
    drag=true;el.setPointerCapture(e.pointerId);el.classList.add('dragging');
    const r=el.getBoundingClientRect(),pr=el.parentElement.getBoundingClientRect();
    ox=r.left-pr.left;oy=r.top-pr.top;sx=e.clientX;sy=e.clientY;
    el.style.left=ox+'px';el.style.top=oy+'px';el.style.right='auto';el.style.bottom='auto';el.style.transform='none';
    e.preventDefault();
  });
  el.addEventListener('pointermove',e=>{
    if(!drag)return;
    const pr=el.parentElement.getBoundingClientRect();
    let nx=ox+(e.clientX-sx),ny=oy+(e.clientY-sy);
    nx=Math.max(2,Math.min(nx,pr.width-el.offsetWidth-2));
    ny=Math.max(2,Math.min(ny,pr.height-el.offsetHeight-2));
    el.style.left=nx+'px';el.style.top=ny+'px';
  });
  const end=()=>{drag=false;el.classList.remove('dragging');};
  el.addEventListener('pointerup',end);el.addEventListener('pointercancel',end);
})();

