/* ============================================================
   MTG · multiscale tree graph mini-viz (grows with the plant)
   ============================================================ */
function drawMTG(iter,branch,health){
  const svg=document.getElementById('mtg');while(svg.firstChild)svg.removeChild(svg.firstChild);
  const W=240,H=150;
  const lvlY=[20,55,95,132];
  const colors=['var(--cream)','var(--teal)','var(--gold)','var(--bright)'];
  const cols=['#e8e0d0','#55c4a0','#c8a96e','#9ed855'];
  // node counts per scale
  const n0=1, n1=2, n2=Math.min(9,Math.max(2,Math.round(branch*1.6))), n3=Math.min(13,Math.max(3,Math.round(iter*1.5)));
  const counts=[n0,n1,n2,n3];
  const pos=[[],[],[],[]];
  counts.forEach((c,li)=>{for(let i=0;i<c;i++){const x=W*(i+1)/(c+1);pos[li].push([x,lvlY[li]]);}});
  // edges level→level
  for(let li=0;li<3;li++){
    pos[li+1].forEach((pt,j)=>{
      const parent=pos[li][Math.floor(j/pos[li+1].length*pos[li].length)];
      L(svg,parent[0],parent[1],pt[0],pt[1],'#26361f',0.8,0.8);
    });
  }
  counts.forEach((c,li)=>{pos[li].forEach(pt=>{
    const r=li===0?5:li===3?2.4:3.4;
    C(svg,pt[0],pt[1],r,cols[li],li===3?(0.5+health*0.5):0.95);
  });});
  // scale labels
  ['L0','L1','L2','L3'].forEach((lab,i)=>{
    const t=el(svg,'text',{x:4,y:lvlY[i]+3,fill:'#3a5a38','font-family':"'DM Mono',monospace",'font-size':'6.5'});
    t.textContent=lab;
  });
}

/* ============================================================
   SERVICES · VVIM Band-3 (modeled from generated geometry)
   ============================================================ */
const SVC_DEFS=[
  {k:'carbon',nm:'carbon sequestration',unit:'kg CO₂e/yr',col:'#9ed855'},
  {k:'lai',nm:'leaf area index',unit:'LAI',col:'#55c4a0',gl:'LAI'},
  {k:'shade',nm:'shade footprint',unit:'m²',col:'#6ab4e8'},
  {k:'storm',nm:'stormwater capture',unit:'L/yr',col:'#55c4a0'},
  {k:'phyto',nm:'phytoremediation',unit:'mg/yr',col:'#9a8ae8',gl:'Phytoremediation'},
  {k:'habitat',nm:'habitat value',unit:'idx',col:'#c8a96e'},
];
const SVC_MAX={carbon:140,lai:5,shade:120,storm:1400,phyto:900,habitat:100};
function updateServices(health,crownW,crownH){
  const sp=SPECIES[state.species],p=state.p;
  const wood=stats.len;            // total stroke length ~ biomass proxy
  const leaves=stats.leaves;
  const crownArea=stats.crownArea;
  const lai=Math.min(5, leaves/Math.max(crownArea/900,0.4)*0.5);
  const shadeFrac=1-Math.exp(-0.6*lai);     // Beer–Lambert (Caribu flavour)
  const carbon=wood*0.085*health;
  const shade=crownArea*0.018*shadeFrac;
  const storm=(crownArea*0.9+stats.rootSpread*40)*0.5*health*(1+(state.env.runoff||0)*0.8);
  const phyto=leaves*sp.phyto*1.4*health;
  const habitat=Math.min(100,(stats.depth*8 + p.density*40 + (sp.form==='mangrove'||sp.form==='grass'?25:10))*health);
  const vals={carbon,lai,shade,storm,phyto,habitat};
  SVC_DEFS.forEach(d=>{
    const v=vals[d.k];const max=SVC_MAX[d.k];
    const fill=Math.max(2,Math.min(100,v/max*100));
    const fe=document.getElementById('svc-'+d.k);
    const ve=document.getElementById('svcv-'+d.k);
    if(fe){fe.style.width=fill+'%';fe.style.background= health<0.5?'#b0894a':d.col;}
    if(ve){ve.innerHTML=(d.k==='lai'?v.toFixed(2):Math.round(v).toLocaleString())+' <u>'+d.unit+'</u>';}
  });
  // resilience score from tolerance margins × health
  const {sStress,fStress,dStress}=computeHealth();
  const margin=1-(sStress+fStress+dStress);
  const score=Math.max(0,Math.min(100,(margin*0.55+health*0.45)*100));
  const rv=document.getElementById('resil-v');
  rv.textContent=Math.round(score);
  rv.style.color= score>66?'var(--bright)':score>40?'var(--gold)':'var(--coral)';
}


