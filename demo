  syncSeasonPips();
}
function syncSeasonPips(){
  const h=state.p.hue;let best=0,bd=9;SEASONS.forEach((s,i)=>{const dd=Math.abs(s.h-h);if(dd<bd){bd=dd;best=i;}});
  document.querySelectorAll('#season-pips .pip').forEach((p,i)=>p.classList.toggle('on',i===best&&bd<0.08));
}
function setSeason(i){const s=SEASONS[i];state.p.hue=s.h;state.p.density=s.d;syncDials();render();}

/* ============================================================
   PRESET LOAD · tween all params → the morph moment
   ============================================================ */
function loadPreset(id){
  stopAll();
  document.querySelectorAll('.preset').forEach(b=>b.classList.toggle('on',b.dataset.id===id));
  const target={...SPECIES[id].p};
  const from={...state.p};
  state.species=id;
  const t0=performance.now(),dur=900;
  function frame(now){
    const k=Math.min(1,(now-t0)/dur);const e=k<.5?2*k*k:1-Math.pow(-2*k+2,2)/2;
    for(const key in target)state.p[key]=from[key]+(target[key]-from[key])*e;
    syncDials();render();
    if(k<1)anim.morph=requestAnimationFrame(frame);else anim.morph=null;
  }
  anim.morph=requestAnimationFrame(frame);
  toast('loaded <b>'+SPECIES[id].name+'</b> · '+SPECIES[id].note);
}

/* ============================================================
   TRANSPORT · grow / season / tour
   ============================================================ */
function stopAll(){
  ['grow','season','tour','morph'].forEach(k=>{if(anim[k]){cancelAnimationFrame(anim[k]);anim[k]=null;}});
  if(anim.tourTimer){clearTimeout(anim.tourTimer);anim.tourTimer=null;}
  document.getElementById('btn-grow').classList.remove('on');
  document.getElementById('btn-season').classList.remove('on');
  document.getElementById('btn-tour').classList.remove('on');
  const hero=document.getElementById('btn-tour-hero');if(hero)hero.classList.remove('on');
  document.querySelectorAll('.tbtn .tri').forEach(t=>t.textContent='▶');
}
function toggleGrow(){
  const btn=document.getElementById('btn-grow');
  if(anim.grow){stopAll();return;}
  stopAll();btn.classList.add('on');btn.querySelector('.tri').textContent='❚❚';
  const dur=6500;let t0=performance.now();
  // start from current age; loop seed→mature→reset
  let startAge=state.p.age;
  function frame(now){
    let k=((now-t0)/dur);
    if(k>=1){t0=now;k=0;startAge=0;}
    state.p.age=Math.min(1,startAge+(1-startAge)*k);
    syncDials();render();
    anim.grow=requestAnimationFrame(frame);
  }
  // restart cleanly from a seed for a satisfying recording
  state.p.age=0.02;startAge=0.02;t0=performance.now();
  anim.grow=requestAnimationFrame(frame);
}
function toggleSeason(){
  const btn=document.getElementById('btn-season');
  if(anim.season){stopAll();return;}
  stopAll();btn.classList.add('on');btn.querySelector('.tri').textContent='❚❚';
  const dur=9000;const t0=performance.now();
  // hue path: bud(.10)→spring(.24)→summer(.5)→turn(.72)→autumn(.86)→dormant(.99)→back
  const path=[{h:.10,d:.6},{h:.24,d:.85},{h:.5,d:1},{h:.72,d:.95},{h:.86,d:.85},{h:.99,d:.03},{h:.10,d:.6}];
  function frame(now){
    const k=((now-t0)%dur)/dur*(path.length-1);
    const i=Math.floor(k),f=k-i;const a=path[i],b=path[i+1];
    state.p.hue=a.h+(b.h-a.h)*f;state.p.density=a.d+(b.d-a.d)*f;
    syncDials();render();
    anim.season=requestAnimationFrame(frame);
  }
  anim.season=requestAnimationFrame(frame);
}
function toggleTour(){
  const btn=document.getElementById('btn-tour');
  if(anim.tourTimer||anim.tour){stopAll();return;}
  stopAll();btn.classList.add('on');btn.querySelector('.tri').textContent='❚❚';
  const hero=document.getElementById('btn-tour-hero');if(hero)hero.classList.add('on');
  let idx=ORDER.indexOf(state.species);
  function next(){
    idx=(idx+1)%ORDER.length;
    const id=ORDER[idx];
    document.querySelectorAll('.preset').forEach(b=>b.classList.toggle('on',b.dataset.id===id));
    const target={...SPECIES[id].p},from={...state.p};state.species=id;
    const t0=performance.now(),dur=1100;
    function frame(now){const k=Math.min(1,(now-t0)/dur);const e=k<.5?2*k*k:1-Math.pow(-2*k+2,2)/2;
      for(const key in target)state.p[key]=from[key]+(target[key]-from[key])*e;syncDials();render();
      if(k<1)anim.tour=requestAnimationFrame(frame);else{anim.tour=null;anim.tourTimer=setTimeout(next,2600);}}
    anim.tour=requestAnimationFrame(frame);
  }
  anim.tourTimer=setTimeout(next,400);
}

