/* ---- glossary tooltip (event-delegated, body-anchored so it never clips) ---- */
const gtip=document.getElementById('gtip');
function showTip(t){
  const key=t.dataset.gl,lit=t.dataset.tip;let html=lit||'';
  if(key&&GLOSSARY[key])html=`<b>${key}</b>${GLOSSARY[key]}`;
  if(!html)return;
  gtip.innerHTML=html;gtip.classList.add('on');
  const r=t.getBoundingClientRect();
  let y=r.top-10-gtip.offsetHeight;if(y<6)y=r.bottom+10;
  let x=Math.max(8,Math.min(r.left,window.innerWidth-gtip.offsetWidth-8));
  gtip.style.left=x+'px';gtip.style.top=y+'px';
}
document.addEventListener('mouseover',e=>{const t=e.target.closest('[data-gl],[data-tip]');if(t)showTip(t);});
document.addEventListener('mouseout',e=>{const t=e.target.closest('[data-gl],[data-tip]');if(t)gtip.classList.remove('on');});

