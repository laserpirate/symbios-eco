/* ============================================================
   GROWTH KERNEL · fractional L-system (smooth growth)
   integer levels fully drawn; the fractional level emerges as
   a shortened, fading tip → continuous growth animation
   ============================================================ */
function grow(svg,o,st){
  const frac=o.iter-Math.floor(o.iter);
  const gTrop=o.gravitropism||0;                  // 0 = no pull (canopy); >0 = roots curve toward straight-down
  const floorY=(o.rootFloor==null)?null:o.rootFloor;
  function pullDown(t){                            // bias a heading toward +90° (down), damped so it curves not snaps
    let d=90-t;d=((d+540)%360)-180;               // shortest signed delta to down
    return t+gTrop*d*0.5;
  }
  function leafAt(x,y,sz,op){
    st.tips++;
    if(o.leafColor && o.rng()>o.skip){C(svg,x,y,Math.max(0.5,sz*(0.55+o.rng()*0.7)),o.leafColor,op);st.leaves++;}
  }
  function step(x,y,theta,len,depth,w){
    // terminal by minimum length → full canopy leaf
    if(len<o.minLen){leafAt(x,y,o.leafSize,o.leafOpacity);return;}
    if(gTrop)theta=pullDown(theta);               // gravitropism: heading curves toward down each segment
    const j=(o.rng()-0.5)*2*o.jitter;
    const emerging=depth<1;                       // the youngest, still-growing generation
    const segLen=emerging?len*Math.max(0.06,frac):len;
    const nx=x+Math.cos((theta+j)*Math.PI/180)*segLen;
    let ny=y+Math.sin((theta+j)*Math.PI/180)*segLen;
    if(floorY!=null&&ny<floorY)ny=floorY;         // hard floor — a root vertex never rises above ground
    L(svg,x,y,nx,ny,o.color,Math.max(w,o.minWidth).toFixed(2),emerging?0.25+0.6*frac:1);
    st.seg++;st.len+=segLen;st.top=Math.min(st.top,ny);st.depth=Math.max(st.depth,o.iter-depth);
    if(nx<st.bx0)st.bx0=nx;if(nx>st.bx1)st.bx1=nx;
    if(emerging){                                  // emerging tip: a small leaf that swells as it matures
      leafAt(nx,ny,o.leafSize*(0.4+0.6*frac),o.leafOpacity*(0.45+0.55*frac));
      return;
    }
    const bc=o.branchCount;
    if(depth<2){                                   // outermost FULL generation → the canopy
      leafAt(nx,ny,o.leafSize*(0.72+0.28*frac),o.leafOpacity);
      if(frac>0.02){                               // sprout the next generation as faint, growing twigs
        for(let i=0;i<bc;i++){
          const ba=bc===1?0:(i-(bc-1)/2)*o.angle;
          const asym=o.asym*o.angle*(o.rng()-0.5);
          step(nx,ny,(theta+j)+ba+asym+o.gravity,len*o.decay,depth-1,w*o.widthDecay);
        }
      }
      return;
    }
    for(let i=0;i<bc;i++){                          // interior generations branch normally
      const ba=bc===1?0:(i-(bc-1)/2)*o.angle;
      const asym=o.asym*o.angle*(o.rng()-0.5);
      const newDir=(theta+j)+ba+asym+o.gravity;
      const newLen=len*(o.decay+(o.rng()-0.5)*(o.decayJitter||0));
      step(nx,ny,newDir,newLen,depth-1,w*o.widthDecay);
    }
  }
  st.bx0=o.cx;st.bx1=o.cx;
  step(o.cx,o.cy,o.dir,o.length,o.iter,o.width);
}

/* monopodial whorl (pine): central leader + tiers */
function growWhorl(svg,o,st){
  const tiers=Math.max(1,Math.round(o.iter*1.4));
  let x=o.cx,y=o.cy,w=o.width;
  const seg=o.length*0.42;
  for(let t=0;t<tiers;t++){
    const ny=y-seg*(1-t*0.02);
    L(svg,x,ny+seg,x,ny,o.color,Math.max(w,o.minWidth));st.seg++;st.len+=seg;st.top=Math.min(st.top,ny);
    const k=Math.max(3,Math.round(o.branchCount));
    const tierLen=o.length*0.5*(1-t/(tiers+1));
    for(let b=0;b<k;b++){
      const ang=(b/k)*360;
      const down=o.gravity+18;
      const ex=x+Math.cos(ang*Math.PI/180)*tierLen*0.5;
      // branch as small drawBranch-ish line with needle clusters
      const bx=x+Math.cos((ang)*Math.PI/180)*tierLen*0.5;
      const by=ny+Math.sin(down*Math.PI/180)*tierLen*0.5+tierLen*0.18;
      L(svg,x,ny,bx,by,o.color,Math.max(w*0.6,o.minWidth));st.seg++;st.len+=tierLen*0.5;
      if(o.leafColor&&o.density>0.05){const nN=Math.round(4*o.density);for(let n=0;n<nN;n++){const f=n/Math.max(nN,1);C(svg,x+(bx-x)*f,ny+(by-ny)*f,o.leafSize*(0.7+o.rng()*0.5),o.leafColor,o.leafOpacity);st.leaves++;st.tips++;}}
      if(bx<st.bx0)st.bx0=bx;if(bx>st.bx1)st.bx1=bx;
    }
    y=ny;w*=0.9;
  }
  st.depth=tiers;
}

/* grass clump (cordgrass / switchgrass): many blades */
function growGrass(svg,o,st){
  const blades=Math.round(10+o.iter*9);
  st.bx0=o.cx;st.bx1=o.cx;
  for(let i=0;i<blades;i++){
    const off=(o.rng()-0.5)*o.length*0.5;
    const bx=o.cx+off;
    const h=o.length*(0.55+o.rng()*0.6);
    const lean=(o.rng()-0.5)*o.angle*2+ (off>0?o.gravity:-o.gravity);
    const tx=bx+Math.sin(lean*Math.PI/180)*h*0.5;
    const ty=o.cy-h;
    const mx=bx+Math.sin(lean*Math.PI/180)*h*0.25;
    const my=o.cy-h*0.55;
    const path=document.createElementNS(NS,'path');
    path.setAttribute('d',`M${bx.toFixed(1)} ${o.cy} Q${mx.toFixed(1)} ${my.toFixed(1)} ${tx.toFixed(1)} ${ty.toFixed(1)}`);
    path.setAttribute('fill','none');path.setAttribute('stroke',o.leafColor||o.color);
    path.setAttribute('stroke-width',(1+o.rng()*0.6).toFixed(2));path.setAttribute('stroke-linecap','round');
    path.setAttribute('opacity',(o.leafOpacity*(0.7+o.rng()*0.3)).toFixed(2));
    svg.appendChild(path);
    st.seg++;st.len+=h;st.top=Math.min(st.top,ty);st.tips++;
    if(tx<st.bx0)st.bx0=tx;if(tx>st.bx1)st.bx1=tx;
    // occasional seed head (autumn)
    if(o.hue>0.6&&o.rng()<0.3){C(svg,tx,ty,1.6,o.leafColor,0.8);}
  }
  st.leaves=st.tips;st.depth=2;
}

/* mangrove: arching prop roots + branched crown */
function growMangrove(svg,o,st){
  const rootY=o.cy, raise=o.length*0.28;
  const hub={x:o.cx,y:rootY-raise};
  // prop roots arc out from hub to ground
  const nR=5;
  for(let i=0;i<nR;i++){
    const side=(i-(nR-1)/2);
    const footX=o.cx+side*o.length*0.16;
    const cpx=(hub.x+footX)/2+side*4;
    const cpy=hub.y+raise*0.55;
    const path=document.createElementNS(NS,'path');
    path.setAttribute('d',`M${hub.x} ${hub.y.toFixed(1)} Q${cpx.toFixed(1)} ${cpy.toFixed(1)} ${footX.toFixed(1)} ${rootY}`);
    path.setAttribute('fill','none');path.setAttribute('stroke',o.color);
    path.setAttribute('stroke-width',(2.4-Math.abs(side)*0.3).toFixed(2));path.setAttribute('stroke-linecap','round');
    svg.appendChild(path);st.seg++;st.len+=raise;
    if(footX<st.bx0)st.bx0=footX;if(footX>st.bx1)st.bx1=footX;
  }
  // pneumatophores (little vertical pegs) along ground
  for(let i=0;i<8;i++){const px=o.cx+(o.rng()-0.5)*o.length*0.5;L(svg,px,rootY,px,rootY-3-o.rng()*4,o.color,1.1,0.8);}
  // crown grows from hub
  grow(svg,{...o,cx:hub.x,cy:hub.y,dir:-90,length:o.length*0.62},st);
  st.rootSpread=o.length*0.7;
}

/* clonal (aspen): k vertical stems from a shared rhizome */
function growClonal(svg,o,st){
  const stems=Math.max(2,Math.round(2+o.iter*0.4));
  st.bx0=o.cx;st.bx1=o.cx;
  // rhizome line
  L(svg,o.cx-o.length*0.5,o.cy,o.cx+o.length*0.5,o.cy,o.branchCol||o.color,1.2,0.5);
  for(let s=0;s<stems;s++){
    const sx=o.cx+(s-(stems-1)/2)*(o.length*0.9/stems);
    const sc=0.6+o.rng()*0.7;
    grow(svg,{...o,cx:sx,cy:o.cy,length:o.length*0.7*sc,iter:Math.max(2,o.iter-1),
      gravity:o.gravity,density:o.density},st);
  }
  st.depth=o.iter;
}

/* ============================================================
   ROOTS · mirror of the canopy, shaped by root archetype
   ============================================================ */
function drawRoots(svg,sp,cx,groundY,baseLen,scale,rootAmt,canopyHalfW){
  if(sp.form==='mangrove')return baseLen*0.7;            // mangrove draws its own prop roots
  const rng=seedRandom(0x9a2+ORDER.indexOf(state.species));
  const age=state.p.age;
  const matBoost=1+(1-age)*0.35;                         // younger -> proportionally deeper (excavation data)
  const halfW=Math.max(30,canopyHalfW||baseLen);         // laterals reach the dripline (memory rule)
  const col=`rgba(122,112,80,${(0.30+rootAmt*0.28).toFixed(2)})`;
  const type=sp.rootType||'fibrous';
  const blank={bx0:cx,bx1:cx,top:groundY,seg:0,len:0,tips:0,leaves:0,depth:0};
  const active=sp.phyto||0.4;
  const gTrop=(state.p.gravitropism==null?0.6:state.p.gravitropism);

  /* ---- FLOATING (water hyacinth): no soil roots -- a trailing rhizofiltration curtain ---- */
  if(type==='floating'){
    const top=groundY, curtain=baseLen*(0.9+rootAmt*1.1)*scale;
    const spread=halfW*0.85;
    el(svg,'rect',{x:cx-spread-8,y:top,width:(spread+8)*2,height:curtain+14,fill:'rgba(85,140,180,0.05)'});
    const strands=Math.round(14+rootAmt*14);
    for(let i=0;i<strands;i++){
      const sx=cx+(i/(strands-1)-0.5)*spread*2;
      const dl=curtain*(0.55+rng()*0.5);
      const sway=(rng()-0.5)*10;
      PA(svg,`M${sx.toFixed(1)} ${top} Q${(sx+sway).toFixed(1)} ${(top+dl*0.55).toFixed(1)} ${(sx+sway*1.6).toFixed(1)} ${(top+dl).toFixed(1)}`,'rgba(70,110,90,0.55)',0.9,0.8);
      const hairs=Math.round(dl/9);
      for(let h=1;h<hairs;h++){const hy=top+dl*(h/hairs),hx=sx+sway*(h/hairs);
        L(svg,hx,hy,hx-2.4,hy+3,'rgba(90,150,120,0.5)',0.5,0.7);
        L(svg,hx,hy,hx+2.4,hy+3,'rgba(90,150,120,0.5)',0.5,0.7);}
    }
    drawRhizosphere(svg,cx,top+2,spread*0.95,curtain*0.6,active,rng,true);
    return spread;
  }

  /* ---- PHREATOPHYTE PUMP (poplar/willow/vetiver): deep divers to groundwater ---- */
  if(type==='phreatophyte'){
    const depth=baseLen*(0.9+rootAmt*1.1)*matBoost;
    const lat=halfW*0.72;
    const nLat=Math.round(4+rootAmt*4);
    for(let i=0;i<nLat;i++){const a=90+(i-(nLat-1)/2)*20+(rng()-0.5)*10;
      grow(svg,{cx,cy:groundY,dir:a,length:depth*0.32*(0.7+rng()*0.5),decay:0.72,angle:16,jitter:9,branchCount:2,asym:0.4,gravity:4,gravitropism:gTrop,rootFloor:groundY,
        iter:Math.min(3,1.5+rootAmt*2),width:Math.max(1,1.8*scale),widthDecay:0.6,minWidth:0.3,minLen:1.6,
        color:col,leafColor:null,leafSize:0,leafOpacity:0,skip:1,rng},blank);}
    const nDive=3;
    for(let i=0;i<nDive;i++){const off=(i-(nDive-1)/2)*lat*0.4;
      grow(svg,{cx:cx+off,cy:groundY,dir:90+(rng()-0.5)*8,length:depth*(0.8+rng()*0.3),decay:0.9,angle:8,jitter:4,branchCount:1,asym:0.15,gravity:0,gravitropism:gTrop,rootFloor:groundY,
        iter:Math.min(5,3+rootAmt*2.5),width:Math.max(1.6,3*scale),widthDecay:0.72,minWidth:0.5,minLen:1.4,
        color:col,leafColor:null,leafSize:0,leafOpacity:0,skip:1,rng},blank);}
    drawRhizosphere(svg,cx,groundY,lat,depth*0.75,active,rng,false);
    return lat;
  }

  /* ---- TAPROOT / PLATE-SPREADER (oak/robinia/pine): wide radial mat + taproot + sinkers ---- */
  if(type==='taproot'){
    const depth=baseLen*(0.5+rootAmt*0.7)*matBoost;
    const lat=halfW*(1.02+rootAmt*0.15);                 // reach just past the dripline
    grow(svg,{cx,cy:groundY,dir:90,length:depth*0.95,decay:0.82,angle:14,jitter:6,branchCount:2,asym:0.3,gravity:0,gravitropism:gTrop*0.7,rootFloor:groundY,
      iter:Math.min(4.5,2+rootAmt*3),width:Math.max(1.8,3.6*scale),widthDecay:0.62,minWidth:0.4,minLen:1.4,
      color:col,leafColor:null,leafSize:0,leafOpacity:0,skip:1,rng},blank);
    const nLat=Math.round(5+rootAmt*5);
    for(let i=0;i<nLat;i++){const side=(i%2?1:-1),frac=(Math.floor(i/2)+1)/Math.ceil(nLat/2);
      const startA=90-side*(60+frac*18);
      grow(svg,{cx,cy:groundY+2,dir:startA,length:lat*frac*(0.6+rng()*0.4),decay:0.8,angle:20,jitter:8,branchCount:2,asym:0.5,gravity:side*10,gravitropism:gTrop*0.35,rootFloor:groundY,
        iter:Math.min(3.5,2+rootAmt*2),width:Math.max(1,2.2*scale),widthDecay:0.58,minWidth:0.3,minLen:1.8,
        color:col,leafColor:null,leafSize:0,leafOpacity:0,skip:1,rng},blank);}
    drawRhizosphere(svg,cx,groundY,lat*0.9,depth*0.7,active,rng,false);
    return lat;
  }

  /* ---- RHIZOMATOUS (cordgrass/aspen): surface rhizome mat + shallow fibrous cascade (emergent cap) ---- */
  if(type==='rhizomatous'){
    const emergent=(sp.form==='grass');
    const depth=emergent?baseLen*0.5*scale                // absolute-ish cap for emergents (Typha rule)
                         :baseLen*(0.4+rootAmt*0.5)*matBoost;
    const mat=halfW*(1.05+rootAmt*0.35);
    L(svg,cx-mat,groundY+3,cx+mat,groundY+3,col,Math.max(1.4,2.4*scale),0.7);
    const tufts=Math.round(5+rootAmt*6);
    for(let i=0;i<tufts;i++){const tx=cx-mat+(i/Math.max(tufts-1,1))*mat*2;
      for(let k=0;k<3;k++){const a=90+(k-1)*22+(rng()-0.5)*14,dl=depth*(0.5+rng()*0.5);
        L(svg,tx,groundY+3,tx+Math.cos(a*Math.PI/180)*dl,groundY+3+Math.sin(a*Math.PI/180)*dl,col,Math.max(1,1.6*scale),0.6);}}
    drawRhizosphere(svg,cx,groundY+3,mat,depth,active,rng,false);
    return mat;
  }

  /* ---- FIBROUS (default): many spreading feeders to the dripline (the "pump") ---- */
  const depth=baseLen*(0.5+rootAmt*0.7)*matBoost;
  const lat=halfW*(0.95+rootAmt*0.2);
  const n=Math.round(6+rootAmt*8);
  for(let i=0;i<n;i++){let a=90+(i-(n-1)/2)*(15+rootAmt*8)+(rng()-0.5)*10;a=Math.max(18,Math.min(162,a)); // stay below the horizon
    grow(svg,{cx,cy:groundY,dir:a,length:depth*(0.5+rng()*0.45),decay:0.74,angle:18,jitter:10,branchCount:2,asym:0.4,gravity:6,gravitropism:gTrop,rootFloor:groundY,
      iter:Math.min(3.5,2+rootAmt*2),width:Math.max(1,2*scale),widthDecay:0.6,minWidth:0.3,minLen:1.6,
      color:col,leafColor:null,leafSize:0,leafOpacity:0,skip:1,rng},blank);}
  drawRhizosphere(svg,cx,groundY,lat,depth*0.7,active,rng,false);
  return lat;
}

/* rhizosphere = the reaction chamber. A soft exudate halo + microbial fuzz around the
   active root zone, denser for high-phyto species. This is where the remediation happens. */
function drawRhizosphere(svg,cx,topY,halfW,depth,active,rng,inWater){
  if(!state.signals)return;
  const hue=inWater?'rgba(90,180,150,':'rgba(122,150,90,';
  el(svg,'ellipse',{cx:cx,cy:topY+depth*0.42,rx:(halfW*0.95).toFixed(1),ry:(depth*0.55).toFixed(1),
    fill:hue+(0.05+active*0.06).toFixed(3)+')'});
  const n=Math.round(18+active*46);
  for(let i=0;i<n;i++){
    const rx=(rng()-0.5)*halfW*1.7, ry=Math.abs(rng())*depth*0.9;
    C(svg,cx+rx,topY+6+ry,rng()<0.2?1.1:0.6,inWater?'#7fe0c0':'#9ed855',(0.18+active*0.3)*(1-ry/(depth+1)*0.5));
  }
}

/* floating rosette (water hyacinth): bulbous petioles + leaf blades on the water */
function growFloating(svg,o,st){
  st.bx0=o.cx;st.bx1=o.cx;
  const w=o.length*0.9, base=o.cy;
  el(svg,'ellipse',{cx:o.cx,cy:base,rx:(w*0.7).toFixed(1),ry:(w*0.16).toFixed(1),fill:'rgba(90,150,190,0.10)'});
  const n=Math.round(5+o.density*4);
  for(let i=0;i<n;i++){
    const ang=-90+(i-(n-1)/2)*26+(o.rng()-0.5)*8;
    const h=o.length*(0.7+o.rng()*0.5);
    const bx=o.cx+Math.cos(ang*Math.PI/180)*h*0.5;
    const by=base+Math.sin(ang*Math.PI/180)*h*0.5;
    el(svg,'ellipse',{cx:((o.cx+bx)/2).toFixed(1),cy:((base+by)/2).toFixed(1),rx:(3.4*o.leafSize*0.4).toFixed(1),ry:(6*o.leafSize*0.4).toFixed(1),
      transform:`rotate(${ang+90} ${((o.cx+bx)/2).toFixed(1)} ${((base+by)/2).toFixed(1)})`,fill:o.leafColor||'#6f9d4e',opacity:0.85});
    C(svg,bx,by,o.leafSize*1.4,o.leafColor||'#6f9d4e',0.92);
    st.seg++;st.len+=h;st.tips++;st.leaves++;
    st.top=Math.min(st.top,by-6);
    if(bx<st.bx0)st.bx0=bx;if(bx>st.bx1)st.bx1=bx;
  }
  if(o.rng()<0.7){L(svg,o.cx,base-o.length*0.2,o.cx,base-o.length*0.7,'#9a8ae8',1.4,0.8);
    for(let k=0;k<3;k++)C(svg,o.cx+(o.rng()-0.5)*4,base-o.length*(0.55+k*0.05),1.6,'#b0a0f0',0.85);}
  st.depth=2;
}

/* forb / fern (alyssum, pteris): a low clump -- pinnate fronds or slender flowering stems */
function growForb(svg,o,st){
  st.bx0=o.cx;st.bx1=o.cx;
  const fern=(state.species==='pteris');
  const n=Math.round(fern?(4+o.iter*0.9):(6+o.iter*1.2));
  for(let i=0;i<n;i++){
    const side=(o.rng()-0.5);
    const lean=side*o.angle*2.2+ (side>0?o.gravity:-o.gravity);
    const h=o.length*(0.6+o.rng()*0.6);
    const bx=o.cx+side*o.length*0.25;
    const tx=bx+Math.sin(lean*Math.PI/180)*h*0.6;
    const ty=o.cy-h;
    const mx=bx+Math.sin(lean*Math.PI/180)*h*0.3, my=o.cy-h*0.55;
    const path=document.createElementNS(NS,'path');
    path.setAttribute('d',`M${bx.toFixed(1)} ${o.cy} Q${mx.toFixed(1)} ${my.toFixed(1)} ${tx.toFixed(1)} ${ty.toFixed(1)}`);
    path.setAttribute('fill','none');path.setAttribute('stroke',o.leafColor||o.color);
    path.setAttribute('stroke-width',(fern?1.4:1.0).toFixed(2));path.setAttribute('stroke-linecap','round');
    path.setAttribute('opacity',(o.leafOpacity*(0.75+o.rng()*0.25)).toFixed(2));
    svg.appendChild(path);
    st.seg++;st.len+=h;st.top=Math.min(st.top,ty);st.tips++;
    if(fern){
      const pin=Math.round(h/8);
      for(let k=1;k<pin;k++){const f=k/pin;const px=bx+(tx-bx)*f,py=o.cy+(ty-o.cy)*f;
        const pl=o.leafSize*1.6*(1-f*0.4);
        L(svg,px,py,px-pl,py+2,o.leafColor||'#4f7d33',0.7,0.85);
        L(svg,px,py,px+pl,py+2,o.leafColor||'#4f7d33',0.7,0.85);st.leaves++;}
    }else{
      const head=Math.round(4+o.density*4);
      for(let k=0;k<head;k++)C(svg,tx+(o.rng()-0.5)*5,ty+(o.rng()-0.5)*4,1.4,'#d8c85a',0.9);st.leaves+=head;
    }
    if(tx<st.bx0)st.bx0=tx;if(tx>st.bx1)st.bx1=tx;
  }
  st.depth=2;
}

function drawSignals(svg,cx,groundY,crownTop,crownW){
  if(!state.signals)return;
  const rng=seedRandom(0x5160+ORDER.indexOf(state.species));
  const cw=Math.max(60,crownW);
  // --- airborne VOC: rising dotted emanations + signal arcs over the canopy
  for(let i=0;i<9;i++){const bx=cx+(rng()-0.5)*cw*0.85,by=crownTop+8+rng()*36;
    for(let k=0;k<4;k++)C(svg,bx+Math.sin((k+i)*0.9)*3,by-k*8-rng()*3,Math.max(0.3,0.9-k*0.14),'#7fe0c0',(0.5-k*0.09));}
  for(let i=0;i<3;i++){const x1=cx+(rng()-0.5)*cw*0.5,x2=cx+(rng()-0.5)*cw*0.5,y=crownTop-4-rng()*14;
    PA(svg,`M${x1.toFixed(1)} ${(y+6).toFixed(1)} Q${((x1+x2)/2).toFixed(1)} ${(y-8).toFixed(1)} ${x2.toFixed(1)} ${(y+6).toFixed(1)}`,'#7fe0c0',0.7,0.32);}
  // --- mycorrhizal network: dashed underground web from the root crown
  const baseY=groundY+8,nodes=[];
  for(let i=0;i<5;i++){const nx=cx+(i-2)*cw*0.26+(rng()-0.5)*10,ny=baseY+10+rng()*24;nodes.push([nx,ny]);
    DL(svg,cx,baseY,nx,ny,'#9a8ae8',0.8,0.42,'1.5 3');C(svg,nx,ny,1.3,'#9a8ae8',0.5);}
  for(let i=0;i<nodes.length-1;i++)DL(svg,nodes[i][0],nodes[i][1],nodes[i+1][0],nodes[i+1][1],'#55c4a0',0.6,0.26,'1 3');
}

/* ============================================================
   ENVIRONMENT LAYER · ground, waterline (SLR), root system
   ============================================================ */
function drawEnvironment(svg,W,H,health,slr){
  const groundY=H-46;
  // sky/season wash
  const sky=el(svg,'rect',{x:0,y:0,width:W,height:H,fill:'url(#skyGrad)'});
  // ground
  el(svg,'rect',{x:0,y:groundY,width:W,height:H-groundY,fill:'#0a1108'});
  L(svg,0,groundY,W,groundY,'#243a20',1);
  // soil texture dots
  const rng=seedRandom(99);
  for(let i=0;i<70;i++){C(svg,rng()*W,groundY+rng()*(H-groundY),0.6,'#1c2c18',0.6);}
  // waterline from SLR
  const waterY=groundY-slr*150;
  if(slr>0.01){
    el(svg,'rect',{x:0,y:waterY,width:W,height:H-waterY,fill:'rgba(106,180,232,0.07)'});
    L(svg,0,waterY,W,waterY,'rgba(106,180,232,0.5)',1);
    // tick label
    const t=el(svg,'text',{x:8,y:waterY-4,fill:'#6ab4e8','font-family':"'DM Mono',monospace",'font-size':'9','opacity':0.8});
    t.textContent=`tide +${(slr*2).toFixed(1)} m`;
  }
  return groundY;
}

/* ============================================================
   RENDER · the whole frame
   ============================================================ */
function computeHealth(){
  const sp=SPECIES[state.species],e=state.env;
  const sStress=Math.max(0,e.salinity-sp.tol.salt);
  const fStress=Math.max(0,(e.slr+(e.runoff||0)*0.35)-sp.tol.flood);
  const dStress=Math.max(0,e.drought-sp.tol.drought);
  const total=sStress*1.1+fStress*1.2+dStress*0.9;
  const health=Math.max(0.06,Math.min(1,1-total));
  const flags=[];
  if(sStress>0.02)flags.push('salinity');
  if(fStress>0.02)flags.push((e.runoff||0)*0.35>e.slr?'runoff':'inundation');
  if(dStress>0.02)flags.push('drought');
  return{health,flags,sStress,fStress,dStress};
}

function render(){
  const svg=document.getElementById('viewport');
  const W=800,H=560;
  while(svg.firstChild)svg.removeChild(svg.firstChild);
  // defs: season sky gradient
  const defs=el(svg,'defs',{});
  const hp=state.p.hue;
  const skyTop = hp<.16?'#0c1810':hp<.40?'#0c1a10':hp<.62?'#0c1810':hp<.92?'#140f0a':'#0a0f12';
  const grad=el(defs,'linearGradient',{id:'skyGrad',x1:0,y1:0,x2:0,y2:1});
  el(grad,'stop',{offset:0,'stop-color':skyTop});
  el(grad,'stop',{offset:1,'stop-color':'#090e08'});

  const{health,flags}=computeHealth();
  const groundY=drawEnvironment(svg,W,H,health,state.env.slr);

  const sp=SPECIES[state.species];
  const p=state.p;
  // age → iterations (continuous) + scale
  const minI=sp.form==='grass'?1.2:1.0, maxI=sp.form==='monopodial'?7:sp.form==='grass'?6:8;
  const iter=minI+p.age*(maxI-minI);
  const scale=0.32+p.age*0.68;
  // leaf colour from hue ramp, drought desaturates, poor health browns
  let leafCol=leafRamp(p.hue);
  if(health<0.95)leafCol=lerpColor(leafCol,'#9a7a3a',(1-health)*0.85);
  const leafy = p.density>0.02 && p.hue<0.93; // winter/dormant → bare
  const skipBase=(1-p.density);
  const skip=Math.min(0.95, skipBase + (1-health)*0.4);

  // canopy group (gentle breeze)
  const grp=el(svg,'g',{id:'canopy-grp'});
  grp.style.transformOrigin=`${W/2}px ${groundY}px`;
  grp.style.animation='breathe 9s ease-in-out infinite';

  // reset stats
  stats={seg:0,len:0,tips:0,leaves:0,crownArea:1,rootSpread:0,top:H,depth:0,bx0:W/2,bx1:W/2};

  const baseLen=sp.baseLen*scale*1.7*(VSCALE[state.species]||1);
  const common={
    cx:W/2,cy:groundY,dir:-90,length:baseLen,
    decay:p.decay,decayJitter:0.06,angle:p.angle,jitter:p.jitter,
    branchCount:Math.round(p.branch),asym:p.asym,gravity:p.gravity,
    iter:iter,width:Math.max(2,4.6*scale),widthDecay:0.66,minWidth:0.5,minLen:0.8,
    color:lerpColor(sp.branchCol,'#6a6a5a',(1-health)*0.5),
    branchCol:sp.branchCol,
    leafColor:leafy?leafCol:null,leafSize:p.leafSize*(0.7+scale*0.5),
    leafOpacity:0.92,density:p.density,skip:skip,hue:p.hue,
    rng:seedRandom(0x71c5 + ORDER.indexOf(state.species)*7),
  };

  // dispatch by form
  switch(sp.form){
    case'monopodial':growWhorl(grp,common,stats);break;
    case'grass':growGrass(grp,common,stats);break;
    case'mangrove':growMangrove(grp,common,stats);break;
    case'clonal':growClonal(grp,common,stats);break;
    case'floating':growFloating(grp,common,stats);break;
    case'forb':growForb(grp,common,stats);break;
    default:grow(grp,common,stats);
  }

  // crown bbox → area proxy
  const crownW=Math.max(20,stats.bx1-stats.bx0);
  const crownH=Math.max(20,groundY-stats.top);
  stats.crownArea=crownW*crownH;

  // root system (archetype-shaped) — drawn AFTER the canopy so the true crown
  // half-width is known, then moved BEHIND the canopy for z-order.
  {
    const rootGrp=el(svg,'g',{id:'roots-grp'});
    stats.rootSpread=drawRoots(rootGrp,sp,W/2,groundY,baseLen,scale,p.root,crownW/2);
    svg.insertBefore(rootGrp,grp);
  }

  // signalling layer (VOC + mycorrhizal) — drawn last, on top
  drawSignals(svg,W/2,groundY,stats.top,crownW);

  updateReadouts(health,flags,iter,crownW,crownH);
  flashPipeline();
  drawMTG(iter,Math.round(p.branch),health);
  updateServices(health,crownW,crownH);
  updateRemediation(sp);
  // frame the plant (canopy + roots) so it fills the canvas on every viewport
  _fit={stats,groundY,baseLen};
  fitViewport();
}
let _fit=null;
function fitViewport(){
  const svg=document.getElementById('viewport');if(!svg)return;
  const W=800,H=560;
  if(!_fit){svg.setAttribute('viewBox',`0 0 ${W} ${H}`);return;}
  const{stats,groundY}=_fit;
  // vertical: canopy top -> ground + a little root depth (this is what kills the dead sky above the crown)
  const top=Math.max(0,stats.top);
  const contentH=Math.max(70,groundY-top);
  const rootDepth=Math.min(Math.max(60,contentH*0.30),140);
  // horizontal: symmetric window around the trunk, wide enough for the crown
  const half=Math.max(70,Math.max(W/2-stats.bx0,stats.bx1-W/2)*1.06);
  const left=W/2-half,right=W/2+half;
  // padding: a touch of sky above, a little soil below
  const padTop=Math.max(16,contentH*0.10),padBot=Math.max(8,contentH*0.05);
  const padX=Math.max(14,(right-left)*0.05);
  let vx=left-padX,vw=(right-left)+padX*2;
  let vy=top-padTop,vh=(groundY+rootDepth)-top+padTop+padBot;
  // match the on-screen aspect so the plant fills the stage centred (no dead band above the crown)
  const cw=svg.clientWidth||W,ch=svg.clientHeight||H,targetAR=cw/ch,curAR=vw/vh;
  if(curAR<targetAR){const need=vh*targetAR;vx-=(need-vw)/2;vw=need;}
  else if(curAR>targetAR){const need=vw/targetAR;vy-=(need-vh)/2;vh=need;}
  // clamp inside the drawn scene so we never expose empty canvas
  if(vw>=W){vx=0;vw=W;}else{if(vx<0)vx=0;if(vx+vw>W)vx=W-vw;}
  if(vh>=H){vy=0;vh=H;}else{if(vy<0)vy=0;if(vy+vh>H)vy=H-vh;}
  svg.setAttribute('viewBox',`${vx.toFixed(1)} ${vy.toFixed(1)} ${vw.toFixed(1)} ${vh.toFixed(1)}`);
}
let _rzT;window.addEventListener('resize',()=>{clearTimeout(_rzT);_rzT=setTimeout(fitViewport,150);});

